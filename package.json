{
  "name": "azf-archive-v2",
  "version": "2.0.0",
  "description": "Azure function for archive operations in P360 (version 2)",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "test": "npx @biomejs/biome check && tsc && node --test 'dist/test/**/*.test.js'",
    "lint:fix": "npx @biomejs/biome check --write",
    "test:offline": "npx @biomejs/biome check && tsc && node --test 'dist/test/**/*.test.js'",
    "refresh": "rm -rf node_modules && rm package-lock.json && npm i",
    "start": "npm run build && func start"
  },
  "author": {
    "name": "Jørgen Thorsnes",
    "email": "jorgen.thorsnes@vtfk.no",
    "url": "https://github.com/jorgtho"
  },
  "keywords": [
    "archive",
    "p360",
    "azure",
    "functions",
    "RPC",
    "SIF"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vestfoldfylke/azf-archive-v2.git"
  },
  "bugs": {
    "url": "https://github.com/vestfoldfylke/azf-archive-v2/issues"
  },
  "homepage": "https://github.com/vestfoldfylke/azf-archive-v2#readme",
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@azure/msal-node": "^5.5.0",
    "@vestfoldfylke/loglady": "^2.1.0",
    "node-cache": "^5.1.2",
    "vtfk-schools-info": "^3.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
